# API Environment Variables
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/crossval
MONGODB_DB_NAME=crossval
WEB_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=crossval_session
SESSION_TOKEN_PEPPER=dev-session-token-pepper-replace-in-production-min-32-chars
SESSION_TTL_SECONDS=2592000
TRUST_PROXY=false
LOG_LEVEL=info

# Web Environment Variables
API_UPSTREAM_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
